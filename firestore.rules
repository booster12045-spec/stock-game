rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validTitle() {
      return !request.resource.data.keys().hasAny(['title'])
        || request.resource.data.title == ''
        || (request.resource.data.title == '개발자'
          && request.auth.token.email == 'booster12045@gmail.com');
    }

    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && validTitle();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /rankings/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['nickname', 'score', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 12
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.updatedAt is timestamp
        && validTitle();
      allow delete: if false;
    }
  }
}
